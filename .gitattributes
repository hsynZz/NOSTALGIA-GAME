* text=auto
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
# Generated browser bundles preserve vendor shader whitespace verbatim.
BrowserPrototype/Delivery/*.html -whitespace
# Preserve upstream asset/license evidence byte-for-byte, including source formatting.
SourceArt/Quality02/ThirdParty/** -whitespace
SourceArt/Quality02/Licenses/** -whitespace
*.glb -text
Docs/Quality02/Validation/*.log -text -whitespace
